{
  "manifest_version": "0.2",
  "name": "rubi",
  "display_name": "Rubi",
  "version": "0.2.0",
  "description": "Persistent markdown memory for Claude Desktop: save where you left off and continue in a fresh chat without losing the thread.",
  "long_description": "Keeps notes and handoffs in a markdown vault (opens in Obsidian). When a chat gets long, Claude saves a handoff and you continue in a new chat, spending far less of your usage limit.",
  "author": {
    "name": "Yuri Bedran",
    "url": "https://github.com/YURIBEDRAN"
  },
  "homepage": "https://github.com/YURIBEDRAN/rubi",
  "license": "MIT",
  "server": {
    "type": "node",
    "entry_point": "server/mcp-server.mjs",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/mcp-server.mjs"
      ],
      "env": {
        "RUBI_VAULT": "${user_config.vault}",
        "RUBI_MODO": "app"
      }
    }
  },
  "tools": [
    {
      "name": "rubi_buscar",
      "description": "Busca nas notas e handoffs"
    },
    {
      "name": "rubi_ler",
      "description": "Lê uma nota do vault"
    },
    {
      "name": "rubi_salvar_nota",
      "description": "Salva conhecimento durável"
    },
    {
      "name": "rubi_salvar_handoff",
      "description": "Salva o 'onde paramos'"
    },
    {
      "name": "rubi_ultimo_handoff",
      "description": "Devolve o último handoff"
    },
    {
      "name": "rubi_projetos",
      "description": "Lista os projetos do vault"
    }
  ],
  "user_config": {
    "vault": {
      "type": "directory",
      "title": "Vault folder",
      "description": "Where notes are stored. Can be an Obsidian vault.",
      "required": true,
      "default": "${HOME}/rubi-vault"
    }
  },
  "compatibility": {
    "platforms": [
      "win32",
      "darwin",
      "linux"
    ],
    "runtimes": {
      "node": ">=18.0.0"
    }
  }
}